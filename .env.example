# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend (Tuần 3+).
# Ở bản UI hiện tại (Tuần 1), toàn bộ dữ liệu là mock — chưa cần các biến này để chạy `npm run dev`.

# Gemini (Tuần 2: chatbot QnA thật)
GEMINI_API_KEY=

# Supabase — lưu hội thoại chatbot (server-only, KHÔNG dùng ở trình duyệt).
# Lấy SUPABASE_SECRET_KEY tại: Supabase Dashboard > Settings > API keys > secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase (Tuần 3: database + auth cho client-side, ví dụ /schools)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
